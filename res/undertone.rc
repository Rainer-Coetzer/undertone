// Windows resources: icon, manifest and version info (shows under Properties > Details).
#include <winver.h>

1 ICON "undertone.ico"
1 24 "undertone.manifest"   // 24 = RT_MANIFEST

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Rainer"
            VALUE "FileDescription",  "Undertone - karaoke player that removes vocals"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "Undertone"
            VALUE "LegalCopyright",   "Rainer. Bundled components under their own licences."
            VALUE "OriginalFilename", "Undertone.exe"
            VALUE "ProductName",      "Undertone"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
